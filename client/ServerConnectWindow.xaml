<Window x:Class="client_side.ServerConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to server" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24,16,24,20">
        <Label HorizontalAlignment="Center" FontSize="20">Connect to server</Label>
        <TextBlock x:Name="lblReason" TextWrapping="Wrap" Margin="0,4,0,8"/>

        <Label Content="Server address" Padding="0,8,0,2"/>
        <TextBox x:Name="txtHost" MaxLength="253" Height="26" VerticalContentAlignment="Center"/>

        <Label Content="Port" Padding="0,8,0,2"/>
        <TextBox x:Name="txtPort" MaxLength="5" Height="26" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="lblErrMsg" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="btnConnect" Content="Connect" Width="120" Height="30" Margin="0,0,10,0"
                    IsDefault="True" Click="btnConnect_Click"/>
            <Button Content="Quit" Width="120" Height="30" IsCancel="True" Click="btnQuit_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
