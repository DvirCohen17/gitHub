<Window x:Class="client_side.ServerConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to server" Width="1240" Height="780">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" CornerRadius="12">
    <StackPanel Margin="36,30,36,30">
        <Border Style="{StaticResource BrandMark}" Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center"/>
        <TextBlock Text="Connect to server" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,14,0,8"/>
        <TextBlock x:Name="lblReason" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,0,0,8"/>

        <TextBlock Text="Server address" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="txtHost" MaxLength="253" Height="34"/>

        <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="txtPort" MaxLength="5" Height="34"/>

        <TextBlock x:Name="lblErrMsg" Style="{StaticResource ErrorText}" Margin="0,12,0,0"/>

        <Button x:Name="btnConnect" Content="Connect" Style="{StaticResource PrimaryButton}" Height="38" HorizontalAlignment="Stretch"
                Margin="0,14,0,0" IsDefault="True" Click="btnConnect_Click"/>
        <Button Content="Quit" Style="{StaticResource GhostButton}" Height="34" HorizontalAlignment="Stretch"
                Margin="0,8,0,0" IsCancel="True" Click="btnQuit_Click"/>
    </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
