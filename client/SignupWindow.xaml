<Window x:Class="client_side.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="Sign up" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24,16,24,20">
        <Label HorizontalAlignment="Center" FontSize="24">Create account</Label>

        <Label Content="Username (3-30 letters, digits, . __ -)" Padding="0,8,0,2"/>
        <TextBox x:Name="txtUsername" MaxLength="30" Height="26" VerticalContentAlignment="Center"/>

        <Label Content="Email" Padding="0,8,0,2"/>
        <TextBox x:Name="txtEmail" MaxLength="100" Height="26" VerticalContentAlignment="Center"/>

        <Label Content="Password (at least 6 characters)" Padding="0,8,0,2"/>
        <PasswordBox x:Name="pwdPassword" MaxLength="64" Height="26" VerticalContentAlignment="Center"/>

        <Label Content="Confirm password" Padding="0,8,0,2"/>
        <PasswordBox x:Name="pwdConfirm" MaxLength="64" Height="26" VerticalContentAlignment="Center"/>

        <TextBlock x:Name="lblErrMsg" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <Button x:Name="btnSignup" Content="Sign up" Width="150" Height="30" Margin="0,12,0,0" IsDefault="True" Click="btnSignup_Click"/>

        <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0">Already have an account?
            <Hyperlink Click="hprlnkLogin">Login</Hyperlink>
        </TextBlock>
    </StackPanel>
</Window>
