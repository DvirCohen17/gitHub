<Window x:Class="client_side.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="Messages - gitHub Demo" Width="1240" Height="780">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,10" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="←  Home" Style="{StaticResource GhostButton}" Height="32" Click="Back_Click"/>
                <Border DockPanel.Dock="Left" Style="{StaticResource BrandMark}" Margin="10,0,10,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Messages" Style="{StaticResource H2}" FontSize="17" VerticalAlignment="Center"/>
                <Button x:Name="markAllBtn" DockPanel.Dock="Right" Content="Mark all as read" Style="{StaticResource PrimaryButton}" Height="32"
                        Click="MarkAllAsRead_Click" ToolTip="Invites and friend requests stay until you answer them"/>
                <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}" Height="32" Margin="0,0,6,0" Click="Refresh_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" MaxWidth="900" Margin="24,18,24,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesListView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Accept" Style="{StaticResource PrimaryButton}" Height="30" Margin="8,0,0,0" Click="approveRequest_Click" Tag="{Binding}"
                                                Visibility="{Binding IsRequest, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Decline" Height="30" Margin="8,0,0,0" Click="declineRequest_Click" Tag="{Binding}"
                                                Visibility="{Binding IsRequest, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Mark as read" Style="{StaticResource GhostButton}" Height="30" Margin="8,0,0,0" Click="MarkAsRead_Click" Tag="{Binding}"
                                                Visibility="{Binding IsRequest, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    </StackPanel>
                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource Theme.AccentSoft}" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Theme.Accent}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource Caption}" FontSize="11.5"/>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                                            <Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Text, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Visibility, ElementName=txtEmpty}">
                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Border}"/>
                <TextBlock x:Name="txtEmpty" Text="You're all caught up." Style="{StaticResource Muted}" FontSize="15" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="18,6">
            <TextBlock x:Name="txtStatus" Style="{StaticResource Caption}"/>
        </Border>
    </Grid>
</Window>
