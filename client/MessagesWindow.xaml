<Window x:Class="client_side.MessagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="Messages" Width="640" Height="520" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock Text="Messages" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Width="80" Height="28" IsCancel="True" Click="Close_Click"/>
            <Button DockPanel.Dock="Right" Content="Refresh" Width="80" Height="28" Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button x:Name="markAllBtn" DockPanel.Dock="Right" Content="Mark all as read" Width="130" Height="28" Margin="0,0,8,0"
                    Click="MarkAllAsRead_Click" ToolTip="Invites and friend requests stay until you answer them"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesListView">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="#66888888" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Accept" Width="70" Height="26" Margin="8,0,0,0" Click="approveRequest_Click" Tag="{Binding}"
                                                Visibility="{Binding IsRequest, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Decline" Width="70" Height="26" Margin="8,0,0,0" Click="declineRequest_Click" Tag="{Binding}"
                                                Visibility="{Binding IsRequest, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Mark as read" Width="100" Height="26" Margin="8,0,0,0" Click="MarkAsRead_Click" Tag="{Binding}"
                                                Visibility="{Binding IsRequest, Converter={StaticResource InverseBoolToVisibility}}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Opacity="0.6"/>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Sender, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding Text, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="txtEmpty" Text="You're all caught up." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.65" FontSize="15" Visibility="Collapsed"/>
        </Grid>

        <TextBlock x:Name="txtStatus" Grid.Row="2" Margin="0,8,0,0" Opacity="0.65" TextWrapping="Wrap"/>
    </Grid>
</Window>
