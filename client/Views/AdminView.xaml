<UserControl x:Class="GitHubDemo.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitHubDemo.Controls"
             xmlns:vm="clr-namespace:GitHubDemo.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Stat" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Width" Value="170"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="36,28,36,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Server admin" Style="{StaticResource H1}"/>
            <TextBlock Text="Live numbers refresh every 10 seconds. Changes here take effect immediately." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
            <WrapPanel>
                <Border Style="{StaticResource Stat}">
                    <StackPanel><TextBlock Text="ONLINE" Style="{StaticResource H3}"/><TextBlock Text="{Binding OnlineUsers}" FontSize="26" FontWeight="SemiBold" AutomationProperties.AutomationId="StatOnline"/>
                        <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Sessions, Mode=OneWay}"/> <Run Text="connections"/></TextBlock></StackPanel>
                </Border>
                <Border Style="{StaticResource Stat}">
                    <StackPanel><TextBlock Text="ACCOUNTS" Style="{StaticResource H3}"/><TextBlock Text="{Binding Users}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding BannedUsers, Mode=OneWay}"/> <Run Text="suspended"/></TextBlock></StackPanel>
                </Border>
                <Border Style="{StaticResource Stat}">
                    <StackPanel><TextBlock Text="PROJECTS" Style="{StaticResource H3}"/><TextBlock Text="{Binding Projects}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding Files, Mode=OneWay}"/> <Run Text="files,"/> <Run Text="{Binding OpenFiles, Mode=OneWay}"/> <Run Text="open"/></TextBlock></StackPanel>
                </Border>
                <Border Style="{StaticResource Stat}">
                    <StackPanel><TextBlock Text="REQUESTS / MIN" Style="{StaticResource H3}"/><TextBlock Text="{Binding RequestsPerMinute}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}"><Run Text="Up"/> <Run Text="{Binding Uptime, Mode=OneWay}"/></TextBlock></StackPanel>
                </Border>
                <Border Style="{StaticResource Stat}">
                    <StackPanel><TextBlock Text="PROGRAMS RUNNING" Style="{StaticResource H3}"/><TextBlock Text="{Binding Runs}" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Run code is off" Style="{StaticResource Caption}" Visibility="{Binding RunEnabled, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/></StackPanel>
                </Border>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
                <RadioButton Style="{StaticResource TabRadio}" Content="Users" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=users}"/>
                <RadioButton Style="{StaticResource TabRadio}" Content="Projects" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=projects}"/>
            </StackPanel>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource HasValue}}"/>
        </StackPanel>

        <Grid>
            <!-- users -->
            <DockPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=users}">
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,10"
                         c:Hint.Text="Search name or email, then Enter" Text="{Binding UserQuery, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding LoadUsersCommand}"/></TextBox.InputBindings>
                </TextBox>
                <ListBox ItemsSource="{Binding UserList}" ItemContainerStyle="{StaticResource PlainItem}" AutomationProperties.AutomationId="AdminUsers">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AdminUser}">
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Disconnect" Margin="0,0,6,0" Visibility="{Binding Online, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.KickCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        <Button Margin="0,0,6,0" Command="{Binding DataContext.ToggleAdminCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsMe, Converter={StaticResource Not}}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Make admin"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Content" Value="Remove admin"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Command="{Binding DataContext.BanCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding IsMe, Converter={StaticResource Not}}" AutomationProperties.Name="Ban">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                    <Setter Property="Content" Value="Suspend"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Banned}" Value="True"><Setter Property="Content" Value="Lift suspension"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                    <c:Avatar User="{Binding User}" Size="36" ShowPresence="True" Margin="0,0,12,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="{Binding User.Name}" Style="{StaticResource LinkButton}" FontWeight="SemiBold"
                                                    Command="{Binding DataContext.OpenUserCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            <Border Style="{StaticResource AccentPill}" Margin="8,0,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Admin" FontSize="11" Foreground="{DynamicResource Theme.AccentText}"/>
                                            </Border>
                                            <Border Style="{StaticResource Pill}" Background="{DynamicResource Theme.DangerSoft}" Margin="8,0,0,0" Visibility="{Binding Banned, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Suspended" FontSize="11" Foreground="{DynamicResource Theme.Danger}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding Email, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Seen, Mode=OneWay}"/> <Run Text="· joined"/> <Run Text="{Binding Joined, Mode=OneWay}"/>
                                            <Run Text="·"/> <Run Text="{Binding Projects, Mode=OneWay}"/> <Run Text="projects"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource Theme.Danger}" Visibility="{Binding BanReason, Converter={StaticResource HasValue}}">
                                            <Run Text="Reason:"/> <Run Text="{Binding BanReason, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- projects -->
            <DockPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=projects}">
                <TextBox DockPanel.Dock="Top" Style="{StaticResource SearchBox}" Width="320" HorizontalAlignment="Left" Margin="0,0,0,10"
                         c:Hint.Text="Search projects, then Enter" Text="{Binding ProjectQuery, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding LoadProjectsCommand}"/></TextBox.InputBindings>
                </TextBox>
                <ListBox ItemsSource="{Binding ProjectList}" ItemContainerStyle="{StaticResource PlainItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AdminProject}">
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Open" Margin="0,0,6,0"
                                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        <Button Content="Delete" Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">
                                            <Run Text="{Binding Language, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Visibility, Mode=OneWay}"/> <Run Text="· owner"/>
                                            <Run Text="{Binding Owner.Name, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Members, Mode=OneWay}"/> <Run Text="members ·"/>
                                            <Run Text="{Binding Files, Mode=OneWay}"/> <Run Text="files · updated"/> <Run Text="{Binding Updated, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
