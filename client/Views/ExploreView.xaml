<UserControl x:Class="GitHubDemo.Views.ExploreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitHubDemo.Controls"
             xmlns:vm="clr-namespace:GitHubDemo.ViewModels">
    <DockPanel Margin="40,30,40,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Explore" Style="{StaticResource H1}"/>
            <TextBlock Text="Public projects anyone can watch live. Open one to follow along as its members code." Style="{StaticResource Muted}" Margin="0,4,0,16"/>
            <DockPanel Margin="0,0,0,18" MaxWidth="560" HorizontalAlignment="Left">
                <Button DockPanel.Dock="Right" Content="Search" Margin="8,0,0,0" Command="{Binding SearchCommand}"/>
                <TextBox Style="{StaticResource SearchBox}" c:Hint.Text="Search public projects" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Width="420" AutomationProperties.AutomationId="ExploreSearch">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </StackPanel>
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectCard}">
                            <Button Style="{StaticResource CardButton}" Margin="0,0,12,12" Height="140" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" Style="{StaticResource H2}"/>
                                    <DockPanel DockPanel.Dock="Bottom">
                                        <c:Avatar User="{Binding Owner}" Size="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Owner.Name}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource AccentPill}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Language}" FontSize="11.5" Foreground="{DynamicResource Theme.AccentText}"/>
                                        </Border>
                                    </DockPanel>
                                    <StackPanel Margin="0,6,0,8">
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                                            <Run Text="{Binding MembersText, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding Updated, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE909;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource Theme.Muted}"/>
                <TextBlock Text="No public projects found" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Project owners can make a project public in its settings." Style="{StaticResource Muted}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
