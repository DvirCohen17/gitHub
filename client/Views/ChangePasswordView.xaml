<UserControl x:Class="GitHubDemo.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitHubDemo.Controls">
    <ContentControl Style="{StaticResource AuthLayout}">
        <StackPanel>
            <Button Content="← Back to sign in" Style="{StaticResource LinkButton}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <TextBlock Text="Change password" Style="{StaticResource H1}" FontSize="26"/>

            <StackPanel Visibility="{Binding Done, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Text="You'll need your current password." Style="{StaticResource Muted}" Margin="0,6,0,6"/>
                <TextBlock Text="User name or email" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="User"/>
                <TextBlock Text="Current password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="oldBox" PasswordChanged="Passwords_Changed" AutomationProperties.AutomationId="OldPassword"/>
                <TextBlock Text="New password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="newBox" PasswordChanged="Passwords_Changed" c:Hint.Text="At least 6 characters" AutomationProperties.AutomationId="NewPassword"/>
                <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}"/>
                <PasswordBox x:Name="confirmBox" PasswordChanged="Passwords_Changed" AutomationProperties.AutomationId="Confirm"/>
                <Border Background="{DynamicResource Theme.DangerSoft}" CornerRadius="{StaticResource Radius}" Padding="12,9" Margin="0,16,0,0"
                        Visibility="{Binding Error, Converter={StaticResource HasValue}}">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Theme.Danger}" TextWrapping="Wrap" AutomationProperties.AutomationId="Error"/>
                </Border>
                <Button Content="Change password" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,20,0,0" HorizontalAlignment="Stretch"
                        Command="{Binding ChangeCommand}" IsDefault="True" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                        AutomationProperties.AutomationId="Change"/>
            </StackPanel>

            <StackPanel Visibility="{Binding Done, Converter={StaticResource BoolToVis}}" Margin="0,16,0,0">
                <Border Background="{DynamicResource Theme.AccentSoft}" CornerRadius="{StaticResource Radius}" Padding="14,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" Foreground="{DynamicResource Theme.Success}" Margin="0,0,10,0"/>
                        <TextBlock Text="Your password was changed." AutomationProperties.AutomationId="Done"/>
                    </StackPanel>
                </Border>
                <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,18,0,0" HorizontalAlignment="Stretch" Command="{Binding BackCommand}"/>
            </StackPanel>
        </StackPanel>
    </ContentControl>
</UserControl>
