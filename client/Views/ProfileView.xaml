<UserControl x:Class="GitHubDemo.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitHubDemo.Controls"
             xmlns:vm="clr-namespace:GitHubDemo.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,34" MaxWidth="900" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="28,24">
                <DockPanel>
                    <c:Avatar DockPanel.Dock="Left" User="{Binding User}" Size="96" ShowPresence="True" Margin="0,0,24,0" VerticalAlignment="Top"/>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding PrimaryAction}" Command="{Binding PrimaryCommand}"
                                Visibility="{Binding HasPrimaryAction, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="FriendAction"/>
                        <Button Content="Remove friend" Style="{StaticResource DangerButton}" Command="{Binding RemoveFriendCommand}"
                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Edit profile" Command="{Binding EditProfileCommand}" Visibility="{Binding IsSelf, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding User.Name}" Style="{StaticResource Display}" AutomationProperties.AutomationId="ProfileName"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{Binding User.PresenceBrushKey, Converter={StaticResource KeyBrush}}"/>
                            <TextBlock Text="{Binding User.PresenceText}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="  ·  " Style="{StaticResource Muted}" Visibility="{Binding RelationText, Converter={StaticResource HasValue}}"/>
                            <TextBlock Text="{Binding RelationText}" Foreground="{DynamicResource Theme.AccentText}" Visibility="{Binding RelationText, Converter={StaticResource HasValue}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Bio}" Style="{StaticResource Body}" Margin="0,14,0,0" FontSize="14.5" Visibility="{Binding Bio, Converter={StaticResource HasValue}}"/>
                        <TextBlock Text="No bio yet." Style="{StaticResource Muted}" Margin="0,14,0,0" Visibility="{Binding Bio, Converter={StaticResource HasValue}, ConverterParameter=invert}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Theme.Muted}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding MemberSince}" Style="{StaticResource Caption}"/>
                            <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Theme.Muted}" Margin="18,0,6,0"/>
                            <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding FriendCount, Mode=OneWay}"/> <Run Text="friends"/></TextBlock>
                            <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Theme.Muted}" Margin="18,0,6,0"
                                       Visibility="{Binding Email, Converter={StaticResource HasValue}}"/>
                            <TextBlock Text="{Binding Email}" Style="{StaticResource Caption}" Visibility="{Binding Email, Converter={StaticResource HasValue}}"/>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource HasValue}}"/>

            <TextBlock Text="PROJECTS" Style="{StaticResource H3}" Margin="0,26,0,10"/>
            <ItemsControl ItemsSource="{Binding Projects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ProjectCard}">
                        <Button Style="{StaticResource CardButton}" Margin="0,0,12,12"
                                Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource H2}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Border Style="{StaticResource AccentPill}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Language}" FontSize="11.5" Foreground="{DynamicResource Theme.AccentText}"/>
                                    </Border>
                                    <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" · Public" Style="{StaticResource Caption}" VerticalAlignment="Center" Visibility="{Binding IsPublic, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="No projects you can both see." Style="{StaticResource Muted}"
                       Visibility="{Binding Projects.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
