<UserControl x:Class="GitHubDemo.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitHubDemo.Controls">
    <ContentControl Style="{StaticResource AuthLayout}">
        <StackPanel>
            <TextBlock Text="Welcome back" Style="{StaticResource H1}" FontSize="26"/>
            <TextBlock Text="Sign in to continue to your projects." Style="{StaticResource Muted}" Margin="0,6,0,10"/>

            <TextBlock Text="User name or email" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="User" x:Name="userBox"/>
            <DockPanel Margin="0,12,0,5">
                <Button DockPanel.Dock="Right" Content="Change password" Style="{StaticResource LinkButton}" FontSize="12.5"
                        Command="{Binding ChangePasswordCommand}" AutomationProperties.AutomationId="ChangePassword"/>
                <TextBlock Text="Password" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource Theme.Muted}"/>
            </DockPanel>
            <PasswordBox x:Name="passwordBox" PasswordChanged="Password_Changed" AutomationProperties.AutomationId="Password"/>
            <CheckBox Content="Keep me signed in on this computer" IsChecked="{Binding Remember}" Margin="0,14,0,0"
                      AutomationProperties.AutomationId="Remember"/>

            <Border Background="{DynamicResource Theme.DangerSoft}" CornerRadius="{StaticResource Radius}" Padding="12,9" Margin="0,16,0,0"
                    Visibility="{Binding Error, Converter={StaticResource HasValue}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Theme.Danger}" TextWrapping="Wrap" AutomationProperties.AutomationId="Error"/>
            </Border>

            <Button Content="Sign in" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,18,0,0" HorizontalAlignment="Stretch"
                    Command="{Binding SignInCommand}" IsDefault="True" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                    AutomationProperties.AutomationId="SignIn"/>
            <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <Border Style="{StaticResource Divider}" Margin="0,24,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="New here?" Style="{StaticResource Muted}" Margin="0,0,6,0"/>
                <Button Content="Create an account" Style="{StaticResource LinkButton}" Command="{Binding CreateAccountCommand}"
                        AutomationProperties.AutomationId="CreateAccount"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="Server:"/> <Run Text="{Binding ServerLabel, Mode=OneWay}"/>
                </TextBlock>
                <Button Content="Change" Style="{StaticResource LinkButton}" FontSize="12" Margin="8,0,0,0" Command="{Binding ChangeServerCommand}"/>
            </StackPanel>
        </StackPanel>
    </ContentControl>
</UserControl>
