<Window x:Class="GitHubDemo.Views.ProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GitHubDemo.Controls"
        xmlns:vm="clr-namespace:GitHubDemo.ViewModels"
        Title="{Binding DialogTitle}" Width="660" Height="640" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
        Background="{DynamicResource Theme.WindowBackground}" Foreground="{DynamicResource Theme.Foreground}"
        FontFamily="{StaticResource Font.UI}" FontSize="13.5" Icon="{StaticResource AppLogo}" UseLayoutRounding="True"
        AutomationProperties.AutomationId="ProjectDialog">
    <DockPanel>
        <!-- header -->
        <Border DockPanel.Dock="Top" Padding="26,20,26,0">
            <StackPanel>
                <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource H1}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton Style="{StaticResource TabRadio}" Content="General" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=general}"/>
                    <RadioButton Style="{StaticResource TabRadio}" Content="People" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=people}"
                                 AutomationProperties.Name="People"/>
                    <RadioButton Style="{StaticResource TabRadio}" Content="Sharing" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=sharing}"
                                 Visibility="{Binding IsCreate, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" AutomationProperties.Name="Sharing"/>
                </StackPanel>
                <Border Style="{StaticResource Divider}"/>
            </StackPanel>
        </Border>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="26,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True"
                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    <Button Content="{Binding SaveText}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" IsDefault="True"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" AutomationProperties.AutomationId="Save"
                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                    <Button Content="Close" Command="{Binding CancelCommand}" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.AutomationId="Error"/>
            </DockPanel>
        </Border>

        <Grid IsEnabled="{Binding IsReadOnly, Converter={StaticResource Not}}">
            <!-- general -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=general}">
                <StackPanel Margin="26,8,26,16">
                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" c:FocusOnShow.Enabled="True"
                             c:Hint.Text="e.g. Chess engine" AutomationProperties.AutomationId="ProjectName"/>
                    <TextBlock Text="Language" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Languages}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding LanguageKey}"
                              Width="220" HorizontalAlignment="Left" IsEnabled="{Binding IsCreate}" AutomationProperties.AutomationId="Language"/>
                    <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource TextArea}" Height="90" MaxLength="500" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             c:Hint.Text="What is this project about? (optional)" AutomationProperties.AutomationId="Description"/>
                    <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,18,0,0">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsPublic}" AutomationProperties.Name="Public project">
                            <StackPanel>
                                <TextBlock Text="Public project" FontWeight="SemiBold"/>
                                <TextBlock Text="Anyone can find it in Explore and watch it live (read-only). Only members can edit and chat." Style="{StaticResource Caption}"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- people -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=people}">
                <StackPanel Margin="26,8,26,16">
                    <StackPanel Visibility="{Binding IsCreate, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <TextBlock Text="MEMBERS" Style="{StaticResource H3}" Margin="0,8,0,8"/>
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:MemberEdit}">
                                    <DockPanel Margin="0,0,0,8">
                                        <CheckBox DockPanel.Dock="Right" Content="Remove" IsChecked="{Binding Remove}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  IsEnabled="{Binding CanChange}"/>
                                        <ComboBox DockPanel.Dock="Right" Width="130" ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" IsEnabled="{Binding CanChange}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource Role}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <c:Avatar User="{Binding User}" Size="30" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding User.Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Admins can edit the project and manage members; only the owner can delete it or change admins."
                                   Style="{StaticResource Caption}" Margin="0,0,0,14"/>

                        <StackPanel Visibility="{Binding PendingInvites.Count, Converter={StaticResource HasValue}}">
                            <TextBlock Text="WAITING FOR AN ANSWER" Style="{StaticResource H3}" Margin="0,8,0,8"/>
                            <ItemsControl ItemsSource="{Binding PendingInvites}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PendingInvite}">
                                        <DockPanel Margin="0,0,0,8">
                                            <CheckBox DockPanel.Dock="Right" Content="Withdraw" IsChecked="{Binding Cancel}" VerticalAlignment="Center"/>
                                            <c:Avatar User="{Binding User}" Size="28" Margin="0,0,10,0"/>
                                            <TextBlock VerticalAlignment="Center">
                                                <Run Text="{Binding User.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="as" Foreground="{DynamicResource Theme.Muted}"/> <Run Text="{Binding Role, Mode=OneWay}" Foreground="{DynamicResource Theme.Muted}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="INVITE FRIENDS" Style="{StaticResource H3}" Margin="0,12,0,8"/>
                    <ItemsControl ItemsSource="{Binding Friends}" AutomationProperties.AutomationId="InviteFriends">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InviteChoice}">
                                <DockPanel Margin="0,0,0,8">
                                    <CheckBox DockPanel.Dock="Right" Content="as admin" IsChecked="{Binding AsAdmin}" IsEnabled="{Binding IsChecked}" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding IsChecked}" AutomationProperties.Name="{Binding User.Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Avatar User="{Binding User}" Size="28" ShowPresence="True" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding User.Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Caption}" Visibility="{Binding HasFriendsToInvite, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                               Text="No friends left to invite. You can also share an invite code from the Sharing tab once the project exists."/>
                </StackPanel>
            </ScrollViewer>

            <!-- sharing -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=sharing}">
                <StackPanel Margin="26,8,26,16">
                    <TextBlock Text="Invite code" Style="{StaticResource H2}" Margin="0,12,0,4"/>
                    <TextBlock Text="Anyone with the code or link can ask to join (or join right away, if you allow it below)." Style="{StaticResource Muted}"/>
                    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,14,0,0" Visibility="{Binding HasInviteCode, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Copy code" Command="{Binding CopyCodeCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Copy link" Command="{Binding CopyLinkCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding InviteCode}" FontFamily="{StaticResource Font.Mono}" FontSize="24" FontWeight="SemiBold"
                                           VerticalAlignment="Center" AutomationProperties.AutomationId="InviteCode"/>
                            </DockPanel>
                            <TextBlock Text="{Binding InviteLink}" Style="{StaticResource Caption}" FontFamily="{StaticResource Font.Mono}" Margin="0,6,0,0"/>
                            <Border Style="{StaticResource Divider}" Margin="0,14"/>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoApprove}">
                                <StackPanel>
                                    <TextBlock Text="Let people join without approval" FontWeight="SemiBold"/>
                                    <TextBlock Text="Otherwise admins get a request in their inbox to accept or decline." Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="New code" Command="{Binding CreateCodeCommand}" Margin="0,0,8,0" ToolTip="The old code stops working"/>
                                <Button Content="Turn off" Style="{StaticResource DangerButton}" Command="{Binding RevokeCodeCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasInviteCode, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <CheckBox Content="Let people join without approval" IsChecked="{Binding AutoApprove}" Margin="0,0,0,12"/>
                        <Button Content="Create an invite code" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Command="{Binding CreateCodeCommand}"
                                AutomationProperties.AutomationId="CreateCode"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
