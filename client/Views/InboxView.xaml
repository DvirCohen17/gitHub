<UserControl x:Class="GitHubDemo.Views.InboxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitHubDemo.Controls"
             xmlns:vm="clr-namespace:GitHubDemo.ViewModels">
    <DockPanel Margin="40,30,40,24" MaxWidth="900" HorizontalAlignment="Stretch">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Chip}" Content="Unread only" IsChecked="{Binding ShowUnreadOnly}"/>
                <Button Content="Mark all as read" Command="{Binding MarkAllReadCommand}" AutomationProperties.AutomationId="MarkAllRead"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Inbox" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                    <Run Text="{Binding DataContext.Session.Unread, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"/> <Run Text="unread"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource HasValue}}"/>

        <Grid>
            <ListBox ItemsSource="{Binding Visible}" ItemContainerStyle="{StaticResource PlainItem}" AutomationProperties.AutomationId="InboxList">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:InboxItem}">
                        <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="{StaticResource RadiusLarge}" BorderThickness="1"
                                AutomationProperties.Name="{Binding Text}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Theme.Surface}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Read}" Value="False">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="Accept" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" AutomationProperties.Name="Accept"
                                            Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Visibility="{Binding NeedsAnswer, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Decline" Margin="0,0,6,0" AutomationProperties.Name="Decline"
                                            Command="{Binding DataContext.DeclineCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Visibility="{Binding NeedsAnswer, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="Open" Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Visibility="{Binding CanOpenProject, Converter={StaticResource BoolToVis}}"/>
                                    <Button Content="&#xE73E;" Style="{StaticResource IconButton}" ToolTip="Mark as read"
                                            Command="{Binding DataContext.ReadCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                                            Visibility="{Binding Read, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" ToolTip="Delete"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                </StackPanel>
                                <Grid DockPanel.Dock="Left" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <c:Avatar User="{Binding From}" Size="38" Visibility="{Binding From, Converter={StaticResource HasValue}}"/>
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource Theme.AccentSoft}"
                                            Visibility="{Binding From, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                                        <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource Theme.AccentText}"/>
                                    </Border>
                                    <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource Theme.Surface}" HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom" Margin="0,0,-5,-4">
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource Theme.AccentText}"/>
                                    </Border>
                                </Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding From.Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Text, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource Theme.Muted}"/>
                <TextBlock Text="You're all caught up" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Invites, friend requests, mentions and task assignments show up here." Style="{StaticResource Muted}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
