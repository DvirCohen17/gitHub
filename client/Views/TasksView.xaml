<UserControl x:Class="GitHubDemo.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitHubDemo.Controls"
             xmlns:vm="clr-namespace:GitHubDemo.ViewModels"
             xmlns:core="clr-namespace:GitHubDemo.Core">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DockPanel Margin="36,24,28,20">
            <!-- header -->
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Back to the project" Command="{Binding BackCommand}"
                        Margin="0,0,10,0" VerticalAlignment="Top" AutomationProperties.Name="Back to project"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding NewTaskCommand}" VerticalAlignment="Top"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" AutomationProperties.AutomationId="NewTask">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource Theme.AccentForeground}"/>
                        <TextBlock Text="New task"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Tasks" Style="{StaticResource H1}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,3,0,0">
                        <Run Text="{Binding ProjectName, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding OpenCount, Mode=OneWay}"/> <Run Text="open,"/>
                        <Run Text="{Binding MineCount, Mode=OneWay}"/> <Run Text="yours,"/>
                        <Run Text="{Binding OverdueCount, Mode=OneWay}" Foreground="{DynamicResource Theme.Danger}"/> <Run Text="overdue"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <!-- filters -->
            <DockPanel DockPanel.Dock="Top" Margin="0,18,0,14">
                <TextBox DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Width="220" c:Hint.Text="Search tasks"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="TaskSearch"/>
                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource ChipRadio}" Content="{Binding Label}" GroupName="taskFilter" Margin="0,0,6,6"
                                         Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}"
                                         AutomationProperties.Name="{Binding Label}">
                                <RadioButton.IsChecked>
                                    <MultiBinding Mode="OneWay">
                                        <MultiBinding.Converter>
                                            <core:EqualsMulti/>
                                        </MultiBinding.Converter>
                                        <Binding Path="Key"/>
                                        <Binding Path="DataContext.Filter" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    </MultiBinding>
                                </RadioButton.IsChecked>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Error}" Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource HasValue}}"/>

            <!-- list -->
            <Grid>
                <ListBox ItemsSource="{Binding Visible}" ItemContainerStyle="{StaticResource PlainItem}" AutomationProperties.AutomationId="TaskList">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TaskItem}">
                            <Border x:Name="card" Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,12" Cursor="Hand"
                                    MouseLeftButtonUp="Task_Click" AutomationProperties.Name="{Binding Text}">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Done, Mode=OneWay}" VerticalAlignment="Top" Margin="0,2,12,0"
                                              ToolTip="Mark as done" AutomationProperties.HelpText="Mark as done" IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                              Command="{Binding DataContext.ToggleDoneCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Assignees}" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type core:UserRef}">
                                                <c:Avatar User="{Binding}" Size="26" Margin="-4,0,0,0"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel>
                                        <TextBlock x:Name="text" Text="{Binding Text}" TextWrapping="Wrap" FontSize="14"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,5,0" x:Name="dueIcon" Foreground="{DynamicResource Theme.Muted}"/>
                                            <TextBlock x:Name="due" Text="{Binding DueLabel}" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="  ·  " Style="{StaticResource Caption}"/>
                                            <TextBlock Text="{Binding AssigneeNames}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Done}" Value="True">
                                    <Setter TargetName="text" Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter TargetName="text" Property="Foreground" Value="{DynamicResource Theme.Muted}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                    <Setter TargetName="due" Property="Foreground" Value="{DynamicResource Theme.Danger}"/>
                                    <Setter TargetName="dueIcon" Property="Foreground" Value="{DynamicResource Theme.Danger}"/>
                                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Theme.Danger}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDueSoon}" Value="True">
                                    <Setter TargetName="due" Property="Foreground" Value="{DynamicResource Theme.Warning}"/>
                                    <Setter TargetName="dueIcon" Property="Foreground" Value="{DynamicResource Theme.Warning}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE9D5;" Style="{StaticResource Icon}" FontSize="34" Foreground="{DynamicResource Theme.Muted}"/>
                    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>
        </DockPanel>

        <!-- editor panel -->
        <Border Grid.Column="1" Width="360" Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="20,22,20,18">
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" ToolTip="Close" Command="{Binding CloseEditorCommand}"/>
                    <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource H2}" FontSize="17" VerticalAlignment="Center"/>
                </DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                    <TextBlock Text="{Binding EditorError}" Style="{StaticResource ErrorText}" Margin="0,0,0,10" Visibility="{Binding EditorError, Converter={StaticResource HasValue}}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteTaskCommand}"
                                Visibility="{Binding Editing, Converter={StaticResource HasValue}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Command="{Binding CloseEditorCommand}"/>
                            <Button Content="Save" Style="{StaticResource PrimaryButton}" Command="{Binding SaveTaskCommand}" AutomationProperties.AutomationId="SaveTask"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="What needs doing?" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource TextArea}" Height="110" Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                                 c:FocusOnShow.Enabled="True" AutomationProperties.AutomationId="TaskText"/>
                        <TextBlock Text="Due" Style="{StaticResource FieldLabel}"/>
                        <DatePicker SelectedDate="{Binding DraftDue}" AutomationProperties.AutomationId="TaskDue"/>
                        <TextBlock Text="Assign to" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl ItemsSource="{Binding Choices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:AssigneeChoice}">
                                    <CheckBox IsChecked="{Binding IsChecked}" Margin="0,4" AutomationProperties.Name="{Binding User.Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Avatar User="{Binding User}" Size="24" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding User.Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
