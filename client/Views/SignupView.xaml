<UserControl x:Class="GitHubDemo.Views.SignupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GitHubDemo.Controls">
    <ContentControl Style="{StaticResource AuthLayout}">
        <StackPanel>
            <Button Content="← Back to sign in" Style="{StaticResource LinkButton}" Command="{Binding BackCommand}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <TextBlock Text="Create your account" Style="{StaticResource H1}" FontSize="26"/>
            <TextBlock Text="It takes a few seconds." Style="{StaticResource Muted}" Margin="0,6,0,6"/>

            <TextBlock Text="User name" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" c:Hint.Text="Letters, digits, . _ -" c:FocusOnShow.Enabled="True"
                     AutomationProperties.AutomationId="Name"/>
            <TextBlock Text="{Binding NameError}" Style="{StaticResource ErrorText}" Visibility="{Binding NameError, Converter={StaticResource HasValue}}"/>

            <TextBlock Text="Email" Style="{StaticResource FieldLabel}"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" c:Hint.Text="you@example.com" AutomationProperties.AutomationId="Email"/>
            <TextBlock Text="{Binding EmailError}" Style="{StaticResource ErrorText}" Visibility="{Binding EmailError, Converter={StaticResource HasValue}}"/>

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="passwordBox" PasswordChanged="Passwords_Changed" c:Hint.Text="At least 6 characters" AutomationProperties.AutomationId="Password"/>
            <TextBlock Text="Confirm password" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="confirmBox" PasswordChanged="Passwords_Changed" AutomationProperties.AutomationId="Confirm"/>
            <TextBlock Text="{Binding PasswordError}" Style="{StaticResource ErrorText}" Visibility="{Binding PasswordError, Converter={StaticResource HasValue}}"/>

            <Border Background="{DynamicResource Theme.DangerSoft}" CornerRadius="{StaticResource Radius}" Padding="12,9" Margin="0,16,0,0"
                    Visibility="{Binding Error, Converter={StaticResource HasValue}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Theme.Danger}" TextWrapping="Wrap" AutomationProperties.AutomationId="Error"/>
            </Border>
            <Button Content="Create account" Style="{StaticResource PrimaryButton}" Height="40" Margin="0,20,0,0" HorizontalAlignment="Stretch"
                    Command="{Binding CreateCommand}" IsDefault="True" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"
                    AutomationProperties.AutomationId="Create"/>
        </StackPanel>
    </ContentControl>
</UserControl>
