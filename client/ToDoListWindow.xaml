<Window x:Class="client_side.ToDoListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="To-do list - gitHub Demo" Width="1240" Height="780"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,10" LastChildFill="False">
                <Button x:Name="ExitBtn" DockPanel.Dock="Left" Content="←  Project" Style="{StaticResource GhostButton}" Height="32" Click="Back_Click"/>
                <Border DockPanel.Dock="Left" Style="{StaticResource BrandMark}" Margin="10,0,10,0"/>
                <TextBlock DockPanel.Dock="Left" Text="To-do list" Style="{StaticResource H2}" FontSize="17" VerticalAlignment="Center"/>
                <Button x:Name="AddIssueBtn" DockPanel.Dock="Right" Content="+ New task" Style="{StaticResource PrimaryButton}" Height="32" Click="Create_Click"/>
                <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource GhostButton}" Height="32" Margin="0,0,6,0" Click="Refresh_Click"/>
            </DockPanel>
        </Border>

        <!-- Open / done -->
        <Border Grid.Row="1" Style="{StaticResource Card}" HorizontalAlignment="Left" Margin="18,16,0,6" Padding="3" CornerRadius="9">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="CurrentIsueBtn" Content="Open" GroupName="view" IsChecked="True" Style="{StaticResource TabButton}" Checked="CurrentIssues_Click"/>
                <RadioButton x:Name="CompletedIsueBtn" Content="Done" GroupName="view" Style="{StaticResource TabButton}" Checked="CompletedIssues_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

        <!-- Tasks -->
            <Grid Grid.Column="0" Margin="18,8,6,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IssueListView">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300" Margin="0,0,12,12" Padding="14,12" Style="{StaticResource Card}"
                                        MouseLeftButtonDown="Card_MouseLeftButtonDown" Tag="{Binding}" Cursor="Hand">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                      Click="CompletedCheckBox_Click" Tag="{Binding}" VerticalAlignment="Top" Margin="0,3,10,0"
                                                      ToolTip="Mark as done"/>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold" FontSize="14"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="26,10,0,0">
                                            <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{Binding DueBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding DueLabel}" Foreground="{Binding DueBrush}" FontSize="12.5"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="26,4,0,0">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Theme.Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding AssigneesLabel}" Style="{StaticResource Caption}" FontSize="12.5"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                            <Button Content="Edit" Height="28" Margin="0,0,6,0" Click="EditIssue_Click" Tag="{Binding}"
                                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Delete" Style="{StaticResource DangerButton}" Height="28" Click="DeleteIssue_Click" Tag="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel x:Name="txtEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding Visibility, ElementName=txtEmpty}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="38" HorizontalAlignment="Center" Foreground="{DynamicResource Theme.Border}"/>
                    <TextBlock x:Name="txtEmpty" Style="{StaticResource Muted}" FontSize="14" Margin="0,12,0,0" TextAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>

            <!-- Task editor (opens beside the list) -->
            <Border x:Name="editorPanel" Grid.Column="1" Width="400" Visibility="Collapsed"
                    Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1,0,0,0">
                <DockPanel Margin="22,18,22,18">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="Cancel" Width="100" Height="34" Margin="0,0,8,0" Click="CancelEdit_Click"/>
                        <Button x:Name="SaveBtn" Content="Create" Style="{StaticResource PrimaryButton}" Width="110" Height="34" Click="SaveTask_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="txtEditorHeading" Text="New task" Style="{StaticResource H1}" FontSize="20"/>

                            <TextBlock Text="What needs to be done?" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="IssueDataTextBox" Height="96" Padding="8,6" VerticalContentAlignment="Top" TextWrapping="Wrap"
                                     AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxLength="1000"/>

                            <TextBlock Text="Due date" Style="{StaticResource FieldLabel}"/>
                            <DatePicker x:Name="IssueDatePicker" SelectedDateFormat="Long" Height="32"/>

                            <TextBlock Text="Assign to" Style="{StaticResource FieldLabel}"/>
                            <Border Style="{StaticResource Card}" Background="{DynamicResource Theme.WindowBackground}" Padding="10,6">
                                <ItemsControl x:Name="MembersList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,4"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <TextBlock x:Name="ErrorTextBlock" Style="{StaticResource ErrorText}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="18,6">
            <TextBlock x:Name="txtStatus" Style="{StaticResource Caption}"/>
        </Border>
    </Grid>
</Window>
