<Window x:Class="client_side.ToDoListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="To-do list" Width="1000" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <Button x:Name="ExitBtn" DockPanel.Dock="Left" Content="← Project" Width="100" Height="30" Click="Back_Click"/>
            <TextBlock DockPanel.Dock="Left" Text="To-do list" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <Button x:Name="AddIssueBtn" DockPanel.Dock="Right" Content="+ New task" Width="110" Height="30" Click="Create_Click"/>
            <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="Refresh" Width="90" Height="30" Margin="0,0,10,0" Click="Refresh_Click"/>
        </DockPanel>

        <!-- Open / done -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton x:Name="CurrentIsueBtn" Content="Open" GroupName="view" IsChecked="True" Margin="0,0,18,0" Checked="CurrentIssues_Click"/>
            <RadioButton x:Name="CompletedIsueBtn" Content="Done" GroupName="view" Checked="CompletedIssues_Click"/>
        </StackPanel>

        <!-- Tasks -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="IssueListView">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="290" Margin="0,0,12,12" Padding="12" BorderThickness="1" CornerRadius="6"
                                    BorderBrush="#66888888" MouseLeftButtonDown="Card_MouseLeftButtonDown" Tag="{Binding}">
                                <StackPanel>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsCompleted, Mode=OneWay}"
                                                  Click="CompletedCheckBox_Click" Tag="{Binding}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                  ToolTip="Mark as done"/>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis"
                                                   FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding DueLabel}" Margin="0,8,0,0" Foreground="{Binding DueBrush}"/>
                                    <TextBlock Text="{Binding AssigneesLabel}" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="Edit" Width="60" Height="24" Margin="0,0,8,0" Click="EditIssue_Click" Tag="{Binding}"
                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Delete" Width="60" Height="24" Click="DeleteIssue_Click" Tag="{Binding}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="txtEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" FontSize="15"
                       Text="Nothing here yet." Visibility="Collapsed"/>
        </Grid>

        <TextBlock x:Name="txtStatus" Grid.Row="3" Margin="0,8,0,0" Opacity="0.65" TextWrapping="Wrap"/>
    </Grid>
</Window>
