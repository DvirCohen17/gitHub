<Window x:Class="client_side.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="Change password" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24,16,24,20">
        <Label HorizontalAlignment="Center" FontSize="24">Change password</Label>

        <Label Content="Username" Padding="0,8,0,2"/>
        <TextBox x:Name="txtUserName" MaxLength="50" Height="26" VerticalContentAlignment="Center"/>

        <Label Content="Current password" Padding="0,8,0,2"/>
        <PasswordBox x:Name="txtOldPassword" MaxLength="64" Height="26" VerticalContentAlignment="Center"/>

        <Label Content="New password (at least 6 characters)" Padding="0,8,0,2"/>
        <PasswordBox x:Name="txtNewPassword" MaxLength="64" Height="26" VerticalContentAlignment="Center"/>

        <Label Content="Confirm new password" Padding="0,8,0,2"/>
        <PasswordBox x:Name="txtConfirmPassword" MaxLength="64" Height="26" VerticalContentAlignment="Center"/>

        <Label x:Name="lblErrMsg" Foreground="Red" FontWeight="Bold" Margin="0,6,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="Change password" Width="140" Height="30" Margin="0,0,10,0" IsDefault="True" Click="btnConfirm_Click"/>
            <Button Content="Back to login" Width="140" Height="30" IsCancel="True" Click="btnReturn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
