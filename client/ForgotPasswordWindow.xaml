<Window x:Class="client_side.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="Change password" Width="1240" Height="780">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" CornerRadius="12">
    <StackPanel Margin="36,30,36,30">
        <Border Style="{StaticResource BrandMark}" Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center"/>
        <TextBlock Text="Change password" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,14,0,12"/>

        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="txtUserName" MaxLength="50" Height="34"/>

        <TextBlock Text="Current password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="txtOldPassword" MaxLength="64" Height="34"/>

        <TextBlock Text="New password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="txtNewPassword" MaxLength="64" Height="34"/>
        <TextBlock Text="At least 6 characters" Style="{StaticResource Caption}" Margin="0,4,0,0"/>

        <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="txtConfirmPassword" MaxLength="64" Height="34"/>

        <Label x:Name="lblErrMsg" Foreground="{DynamicResource Theme.Danger}" Padding="0" Margin="0,12,0,0"/>

        <Button Content="Change password" Style="{StaticResource PrimaryButton}" Height="38" HorizontalAlignment="Stretch"
                Margin="0,14,0,0" IsDefault="True" Click="btnConfirm_Click"/>
        <Button Content="Back to sign in" Style="{StaticResource GhostButton}" Height="34" HorizontalAlignment="Stretch"
                Margin="0,8,0,0" IsCancel="True" Click="btnReturn_Click"/>
    </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
