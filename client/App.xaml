<Application x:Class="GitHubDemo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GitHubDemo.ViewModels"
             xmlns:v="clr-namespace:GitHubDemo.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Design.xaml"/>
                <ResourceDictionary Source="Themes/Avatars.xaml"/>
                <ResourceDictionary Source="Themes/Layouts.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Each page view model is shown by its view. -->
            <DataTemplate DataType="{x:Type vm:ConnectViewModel}"><v:ConnectView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LoginViewModel}"><v:LoginView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SignupViewModel}"><v:SignupView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ChangePasswordViewModel}"><v:ChangePasswordView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><v:HomeView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfileViewModel}"><v:ProfileView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:InboxViewModel}"><v:InboxView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExploreViewModel}"><v:ExploreView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProjectViewModel}"><v:ProjectView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TasksViewModel}"><v:TasksView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AdminViewModel}"><v:AdminView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
