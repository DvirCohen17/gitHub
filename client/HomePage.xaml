<Window x:Class="client_side.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="Profile Page" Width="1200" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,10" LastChildFill="False">
                <Border DockPanel.Dock="Left" Style="{StaticResource BrandMark}"/>
                <TextBlock DockPanel.Dock="Left" Text="gitHub Demo" Style="{StaticResource H2}" FontSize="16" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button x:Name="LogoutBtn" DockPanel.Dock="Right" Content="Log out" Style="{StaticResource GhostButton}" Height="32" Click="LogoutButton_Click"/>
                <Button x:Name="settingsBtn" DockPanel.Dock="Right" Content="Settings" Style="{StaticResource GhostButton}" Height="32" Margin="0,0,4,0" Click="Settings_Click"/>
                <Button x:Name="msgBtn" DockPanel.Dock="Right" Content="Messages" Style="{StaticResource GhostButton}" Height="32" Margin="0,0,4,0" Click="Messages_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- Profile card -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource Card}" Padding="18" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="64" Height="64" CornerRadius="32" Background="{DynamicResource Theme.Accent}" VerticalAlignment="Top">
                        <TextBlock x:Name="txtAvatar" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Theme.AccentForeground}"/>
                    </Border>
                    <StackPanel Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="backButton" Content="←  My profile" Style="{StaticResource GhostButton}" Height="30" Margin="-8,0,8,0"
                                    Visibility="Collapsed" Click="BackButton_Click"/>
                            <TextBlock x:Name="txtProfileName" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                            <Button x:Name="addFriendBtn" Content="+ Add friend" Style="{StaticResource PrimaryButton}" Height="30" Margin="14,0,0,0"
                                    Visibility="Collapsed" Click="AddFriend_Click"/>
                            <Button x:Name="removeFriendBtn" Content="Remove friend" Style="{StaticResource DangerButton}" Height="30" Margin="14,0,0,0"
                                    Visibility="Collapsed" Click="RemoveDisplayedFriend_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="txtProfileEmail" Style="{StaticResource Muted}" Margin="0,2,0,10"/>
                        <StackPanel x:Name="bioEditPanel" Orientation="Horizontal">
                            <TextBox x:Name="BioTextBox" Width="460" MaxLength="300" ToolTip="A short bio others see on your profile"/>
                            <Button x:Name="editButton" Content="Save bio" Height="30" Margin="8,0,0,0" Click="EditBio_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="BioTextBlock" TextWrapping="Wrap" MaxWidth="700" HorizontalAlignment="Left" Visibility="Collapsed"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Projects -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="14" Margin="0,0,16,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10" LastChildFill="False">
                        <TextBlock x:Name="txtProjectsTitle" Text="My projects" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                        <Button x:Name="AddProjectBtn" DockPanel.Dock="Right" Content="+ New project" Style="{StaticResource PrimaryButton}" Height="32"
                                Click="AddProject_Click"/>
                    </DockPanel>
                    <Grid>
                        <ListView x:Name="lstProjects" Padding="0" MouseDoubleClick="LstProjects_MouseDoubleClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2,6" LastChildFill="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="Open" Style="{StaticResource PrimaryButton}" Height="28" Margin="6,0,0,0" Click="OpenProject_Click" Tag="{Binding}"/>
                                            <Button Content="Edit" Height="28" Margin="6,0,0,0" Click="EditProjectInfo_Click" Tag="{Binding}"
                                                    Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Info" Height="28" Margin="6,0,0,0" Click="ViewProjectInfo_Click" Tag="{Binding}"
                                                    Visibility="{Binding CanViewInfo, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Leave" Style="{StaticResource DangerButton}" Height="28" Margin="6,0,0,0" Click="LeaveProject_Click" Tag="{Binding}"
                                                    Visibility="{Binding CanLeave, Converter={StaticResource BoolToVisibility}}"/>
                                            <Button Content="Delete" Style="{StaticResource DangerButton}" Height="28" Margin="6,0,0,0" Click="DeleteProject_Click" Tag="{Binding}"
                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Theme.AccentSoft}" Margin="0,0,12,0">
                                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Theme.Accent}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProjectName}" FontSize="14.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding RoleLabel}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="txtNoProjects" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- People -->
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="txtPeopleTitle" Text="Friends" Style="{StaticResource H2}" Margin="2,0,0,10"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="closeSerachBtn" DockPanel.Dock="Right" Content="Clear" Style="{StaticResource GhostButton}" Height="30" Margin="4,0,0,0"
                                Visibility="Collapsed" Click="closeSearch_Click"/>
                        <Grid>
                            <TextBox x:Name="searchBarTextBox" MaxLength="30" Padding="28,0,6,0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Theme.Muted}" Margin="9,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="searchPlaceholder" Text="Search people by name" Margin="29,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Style="{StaticResource Muted}"/>
                        </Grid>
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="lstFriends" Padding="0" MouseDoubleClick="LstFriends_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3" ToolTip="Double-click to view profile">
                                        <Grid DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0">
                                            <Border CornerRadius="15" Background="{DynamicResource Theme.AccentSoft}">
                                                <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </Border>
                                            <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" Stroke="{DynamicResource Theme.Surface}" StrokeThickness="2"
                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="txtNoPeople" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Muted}"
                                   TextAlignment="Center" Margin="16" Visibility="Collapsed"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="18,6">
            <TextBlock x:Name="txtStatus" Style="{StaticResource Caption}"/>
        </Border>
    </Grid>
</Window>
