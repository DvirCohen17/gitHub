<Window x:Class="client_side.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="Profile Page" Width="1150" Height="720" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Profile header -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,16" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="msgBtn" Content="Messages" Width="120" Height="30" Margin="0,0,8,0" Click="Messages_Click"/>
                <Button x:Name="settingsBtn" Content="Settings" Width="90" Height="30" Margin="0,0,8,0" Click="Settings_Click"/>
                <Button x:Name="LogoutBtn" Content="Log out" Width="90" Height="30" Click="LogoutButton_Click"/>
            </StackPanel>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="backButton" Content="← My profile" Width="110" Height="28" Margin="0,0,12,0"
                            Visibility="Collapsed" Click="BackButton_Click"/>
                    <TextBlock x:Name="txtProfileName" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="addFriendBtn" Content="Add friend" Width="100" Height="28" Margin="14,0,0,0"
                            Visibility="Collapsed" Click="AddFriend_Click"/>
                    <Button x:Name="removeFriendBtn" Content="Remove friend" Width="120" Height="28" Margin="14,0,0,0"
                            Visibility="Collapsed" Click="RemoveDisplayedFriend_Click"/>
                </StackPanel>
                <TextBlock x:Name="txtProfileEmail" Style="{StaticResource Hint}" Margin="0,2,0,6"/>
                <StackPanel x:Name="bioEditPanel" Orientation="Horizontal">
                    <TextBox x:Name="BioTextBox" Width="420" Height="26" MaxLength="300" VerticalContentAlignment="Center"
                             ToolTip="A short bio others see on your profile"/>
                    <Button x:Name="editButton" Content="Save bio" Width="90" Height="26" Margin="8,0,0,0" Click="EditBio_Click"/>
                </StackPanel>
                <TextBlock x:Name="BioTextBlock" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" Visibility="Collapsed"/>
            </StackPanel>
        </DockPanel>

        <!-- Projects -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,16,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                <TextBlock x:Name="txtProjectsTitle" Text="My projects" Style="{StaticResource SectionTitle}"/>
                <Button x:Name="AddProjectBtn" DockPanel.Dock="Right" Content="+ New project" Width="120" Height="28" Click="AddProject_Click"/>
            </DockPanel>
            <Grid>
                <Border BorderThickness="1" CornerRadius="6" BorderBrush="#66888888">
                    <ListView x:Name="lstProjects" Background="Transparent" BorderThickness="0"
                              MouseDoubleClick="LstProjects_MouseDoubleClick" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="4,6" LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Open" Width="62" Height="24" Margin="6,0,0,0" Click="OpenProject_Click" Tag="{Binding}"/>
                                        <Button Content="Edit" Width="56" Height="24" Margin="6,0,0,0" Click="EditProjectInfo_Click" Tag="{Binding}"
                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Info" Width="56" Height="24" Margin="6,0,0,0" Click="ViewProjectInfo_Click" Tag="{Binding}"
                                                Visibility="{Binding CanViewInfo, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Leave" Width="60" Height="24" Margin="6,0,0,0" Click="LeaveProject_Click" Tag="{Binding}"
                                                Visibility="{Binding CanLeave, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="Delete" Width="64" Height="24" Margin="6,0,0,0" Click="DeleteProject_Click" Tag="{Binding}"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProjectName}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding RoleLabel}" Opacity="0.65" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
                <TextBlock x:Name="txtNoProjects" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"
                           TextAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>

        <!-- People -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" x:Name="txtPeopleTitle" Text="Friends" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button x:Name="closeSerachBtn" DockPanel.Dock="Right" Content="Clear" Width="56" Height="28" Margin="6,0,0,0"
                        Visibility="Collapsed" Click="closeSearch_Click"/>
                <Grid>
                    <TextBox x:Name="searchBarTextBox" Height="28" VerticalContentAlignment="Center" MaxLength="30"
                             TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock x:Name="searchPlaceholder" Text="Search people by name..." Margin="6,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Style="{StaticResource Hint}"/>
                </Grid>
            </DockPanel>
            <Grid>
                <Border BorderThickness="1" CornerRadius="6" BorderBrush="#66888888">
                    <ListBox x:Name="lstFriends" Background="Transparent" BorderThickness="0" MouseDoubleClick="LstFriends_MouseDoubleClick"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,4" ToolTip="Double-click to view profile">
                                    <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,8,0" Fill="{Binding StatusBrush}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Opacity="0.6" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <TextBlock x:Name="txtNoPeople" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"
                           TextAlignment="Center" Margin="16" Visibility="Collapsed"/>
            </Grid>
        </DockPanel>

        <TextBlock x:Name="txtStatus" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Style="{StaticResource Hint}"/>
    </Grid>
</Window>
