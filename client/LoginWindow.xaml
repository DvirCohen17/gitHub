<Window x:Class="client_side.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="Login" Width="1240" Height="780">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Border Style="{StaticResource Card}" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" CornerRadius="12">
    <StackPanel Margin="36,30,36,30">
        <Border Style="{StaticResource BrandMark}" Width="52" Height="52" CornerRadius="12" HorizontalAlignment="Center"/>
        <TextBlock Text="Welcome back" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,14,0,2"/>
        <TextBlock Text="Sign in to continue to gitHub Demo" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <TextBlock Text="Username or email" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="txtUsername" MaxLength="50" Height="34"/>

        <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
        <PasswordBox x:Name="pwdPassword" MaxLength="64" Height="34" PasswordChanged="pwdPassword_PasswordChanged"/>

        <DockPanel Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center">
                <Hyperlink Click="hprlnkForgotPassword" Foreground="{DynamicResource Theme.Accent}">Change password</Hyperlink>
            </TextBlock>
            <CheckBox x:Name="chkRememberMe" Content="Remember me" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock x:Name="lblErrMsg" Style="{StaticResource ErrorText}" Margin="0,12,0,0"/>

        <Button x:Name="btnLogin" Content="Sign in" Style="{StaticResource PrimaryButton}" Height="38"
                HorizontalAlignment="Stretch" Margin="0,14,0,0" IsDefault="True" Click="btnLogin_Click"/>

        <TextBlock HorizontalAlignment="Center" Margin="0,18,0,0" Style="{StaticResource Muted}">No account?
            <Hyperlink Click="hprlnkSignup" Foreground="{DynamicResource Theme.Accent}">Create one</Hyperlink>
        </TextBlock>
    </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
