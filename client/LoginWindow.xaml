<Window x:Class="client_side.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        mc:Ignorable="d"
        Title="Login" Width="380" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24,16,24,20">
        <Label HorizontalAlignment="Center" FontSize="24">Login</Label>

        <Label Content="Username or email" Padding="0,8,0,2"/>
        <TextBox x:Name="txtUsername" MaxLength="50" Height="26" VerticalContentAlignment="Center"/>

        <Label Content="Password" Padding="0,8,0,2"/>
        <PasswordBox x:Name="pwdPassword" MaxLength="64" Height="26" VerticalContentAlignment="Center"
                     PasswordChanged="pwdPassword_PasswordChanged"/>

        <CheckBox x:Name="chkRememberMe" Content="Remember me" Margin="0,10,0,0"/>

        <TextBlock x:Name="lblErrMsg" Foreground="Red" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>

        <Button x:Name="btnLogin" Content="Login" Width="150" Height="30" Margin="0,12,0,0" IsDefault="True" Click="btnLogin_Click"/>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left">
                <Hyperlink Click="hprlnkForgotPassword">Change password</Hyperlink>
            </TextBlock>
            <TextBlock DockPanel.Dock="Right">No account?
                <Hyperlink Click="hprlnkSignup">Sign up</Hyperlink>
            </TextBlock>
        </DockPanel>
    </StackPanel>
</Window>
