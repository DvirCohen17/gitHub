<Window x:Class="client_side.ProjectDirectory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Project" Width="1280" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="290"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="← Projects" Width="110" Height="30" Click="ReturnToMainPage_Click"/>
            <TextBlock x:Name="txtProjectTitle" DockPanel.Dock="Left" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0,10,0"/>
            <TextBlock x:Name="txtReadOnlyBadge" DockPanel.Dock="Left" Text="view only" VerticalAlignment="Center"
                       Style="{StaticResource Hint}" Visibility="Collapsed"/>
            <Button x:Name="ToDoListBtn" DockPanel.Dock="Right" Content="To-do list" Width="100" Height="30"
                    Click="ToDoList_Click"/>
        </DockPanel>

        <!-- Files -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
            <TextBlock DockPanel.Dock="Top" Text="Files" Style="{StaticResource SectionTitle}"/>
            <StackPanel x:Name="newFilePanel" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Add" Width="50" Height="26" Margin="6,0,0,0" Click="AddFile_Click"/>
                    <TextBox x:Name="txtNewFileName" Height="26" VerticalContentAlignment="Center" MaxLength="90"
                             KeyDown="TxtNewFileName_KeyDown" ToolTip="New file name (the extension is added for you)"/>
                </DockPanel>
                <TextBlock x:Name="lblCreteErr" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <Border BorderThickness="1" CornerRadius="4" Opacity="1">
                <ListBox x:Name="lstFileList" FontSize="14" Background="Transparent" BorderThickness="0"
                         SelectionChanged="LstFiles_SelectionChanged" PreviewKeyDown="LstFiles_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FileName}" Padding="4,3"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu x:Name="fileContextMenu">
                            <MenuItem Header="Rename" Click="RenameFileMenu_Click"/>
                            <MenuItem Header="Delete" Click="DeleteFileMenu_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Border>
        </DockPanel>

        <!-- Editor -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
                <TextBlock x:Name="txtFileName" DockPanel.Dock="Left" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="closeFileBtn" DockPanel.Dock="Right" Content="Close file" Width="90" Height="26"
                        Click="CloseFile_Click" Visibility="Collapsed"/>
            </DockPanel>
            <Grid>
                <Border BorderThickness="1" CornerRadius="4">
                    <avalonedit:TextEditor x:Name="txtFileContent"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="15"
                                           ShowLineNumbers="True"
                                           Background="Transparent"
                                           Padding="4"
                                           IsReadOnly="True"
                                           Visibility="Hidden"/>
                </Border>
                <TextBlock x:Name="txtEditorPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Style="{StaticResource Hint}" FontSize="15" TextAlignment="Center"
                           Text="Select a file on the left to open it.&#x0a;Everyone in the file sees changes as they are typed."/>
            </Grid>
        </DockPanel>

        <!-- Members + chat -->
        <DockPanel Grid.Row="1" Grid.Column="2" Margin="12,0,0,0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Members" Style="{StaticResource SectionTitle}"/>
                <ItemsControl x:Name="lstMembers">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Padding="0,1">
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                <Run Text="{Binding RoleLabel, Mode=OneWay}" FontStyle="Italic"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="Chat" Style="{StaticResource SectionTitle}"/>
            <StackPanel x:Name="chatInputPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Send" Width="60" Height="30" Margin="6,0,0,0" Click="SendChat_Click"/>
                    <TextBox x:Name="txtChatInput" MinHeight="30" MaxHeight="90" MaxLength="1000" TextWrapping="Wrap"
                             VerticalContentAlignment="Center" KeyDown="TxtChatInput_KeyDown"
                             ToolTip="Enter to send"/>
                </DockPanel>
                <TextBlock x:Name="lblErr" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
            <Border BorderThickness="1" CornerRadius="4">
                <ScrollViewer x:Name="chatScroll" VerticalScrollBarVisibility="Auto" Padding="8,6">
                    <ItemsControl x:Name="lstChat">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Status bar -->
        <TextBlock x:Name="txtStatus" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Style="{StaticResource Hint}"/>
    </Grid>
</Window>
