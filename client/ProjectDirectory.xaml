<Window x:Class="client_side.ProjectDirectory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Project" Width="1320" Height="800" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,10" LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="←  Projects" Style="{StaticResource GhostButton}" Height="32" Click="ReturnToMainPage_Click"/>
                <Border DockPanel.Dock="Left" Style="{StaticResource BrandMark}" Margin="10,0,10,0"/>
                <TextBlock x:Name="txtProjectTitle" DockPanel.Dock="Left" Style="{StaticResource H2}" FontSize="17" VerticalAlignment="Center"/>
                <Border x:Name="txtReadOnlyBadgeBorder" DockPanel.Dock="Left" Margin="10,0,0,0" Padding="8,2" CornerRadius="10"
                        Background="{DynamicResource Theme.SurfaceHover}" VerticalAlignment="Center"
                        Visibility="{Binding Visibility, ElementName=txtReadOnlyBadge}">
                    <TextBlock x:Name="txtReadOnlyBadge" Text="View only" Style="{StaticResource Caption}" Visibility="Collapsed"/>
                </Border>
                <Button x:Name="ToDoListBtn" DockPanel.Dock="Right" Content="To-do list" Style="{StaticResource PrimaryButton}" Height="32"
                        Click="ToDoList_Click"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Files -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FILES" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="6,2,0,8"/>
                    <StackPanel x:Name="renamePanel" DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="txtRenameLabel" Style="{StaticResource Caption}" Margin="2,0,0,4"/>
                        <TextBox x:Name="txtRename" MaxLength="100" KeyDown="TxtRename_KeyDown"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}" Height="28" Margin="0,0,6,0" Click="CancelRename_Click"/>
                            <Button Content="Rename" Style="{StaticResource PrimaryButton}" Height="28" Click="ConfirmRename_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="newFilePanel" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add" Width="56" Height="30" Margin="6,0,0,0" Click="AddFile_Click"/>
                            <TextBox x:Name="txtNewFileName" MaxLength="90" KeyDown="TxtNewFileName_KeyDown"/>
                        </DockPanel>
                        <TextBlock x:Name="lblCreteErr" Style="{StaticResource ErrorText}" FontSize="12" Margin="2,4,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="lstFileList" Padding="0" SelectionChanged="LstFiles_SelectionChanged" PreviewKeyDown="LstFiles_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Theme.Muted}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                                    <TextBlock Text="{Binding FileName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ContextMenu>
                            <ContextMenu x:Name="fileContextMenu">
                                <MenuItem Header="Rename      F2" Click="RenameFileMenu_Click"/>
                                <MenuItem Header="Delete      Del" Click="DeleteFileMenu_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Editor -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Padding="14,8">
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="txtFileName" DockPanel.Dock="Left" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="closeFileBtn" DockPanel.Dock="Right" Content="Close file" Style="{StaticResource GhostButton}"
                                    Height="28" Click="CloseFile_Click" Visibility="Collapsed"/>
                        </DockPanel>
                    </Border>
                    <Grid>
                        <avalonedit:TextEditor x:Name="txtFileContent"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="14.5"
                                               ShowLineNumbers="True"
                                               Background="Transparent"
                                               Padding="10,8"
                                               IsReadOnly="True"
                                               Visibility="Hidden"/>
                        <StackPanel x:Name="txtEditorPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Theme.Border}"/>
                            <TextBlock Text="No file open" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Style="{StaticResource Muted}" TextAlignment="Center"
                                       Text="Pick a file on the left. Everyone in the file sees edits as they're typed."/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Members + chat -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MEMBERS" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <ItemsControl x:Name="lstMembers" DockPanel.Dock="Top" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,3">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Theme.AccentSoft}">
                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" FontSize="11.5"/>
                                    </Border>
                                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                        <Run Text="{Binding RoleLabel, Mode=OneWay}" Foreground="{DynamicResource Theme.Muted}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock DockPanel.Dock="Top" Text="CHAT" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <StackPanel x:Name="chatInputPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Send" Style="{StaticResource PrimaryButton}" Width="64" Height="34"
                                    Margin="6,0,0,0" Click="SendChat_Click"/>
                            <TextBox x:Name="txtChatInput" MinHeight="34" MaxHeight="96" MaxLength="1000" TextWrapping="Wrap"
                                     KeyDown="TxtChatInput_KeyDown" ToolTip="Enter to send, Shift+Enter for a new line"/>
                        </DockPanel>
                        <TextBlock x:Name="lblErr" Style="{StaticResource ErrorText}" FontSize="12" Margin="2,4,0,0"/>
                    </StackPanel>
                    <ScrollViewer x:Name="chatScroll" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="lstChat">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Theme.SurfaceHover}" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Sender}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource Theme.Accent}"/>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock x:Name="txtStatus" Style="{StaticResource Caption}"/>
        </Border>
    </Grid>
</Window>
