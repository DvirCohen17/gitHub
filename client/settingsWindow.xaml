<Window x:Class="client_side.settingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:client_side"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Settings - gitHub Demo" Width="1240" Height="780">
    <Window.Resources>
        <local:ColorNameToBrushConverter x:Key="ColorBrush"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Grid.RowSpan="2" Background="{DynamicResource Theme.Surface}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,12,12,12">
                <Button Content="←  Home" Style="{StaticResource GhostButton}" Height="32" HorizontalAlignment="Left" Margin="0,0,0,14" Click="Back_Click"/>
                <StackPanel Orientation="Horizontal" Margin="6,0,0,18">
                    <Border Style="{StaticResource BrandMark}"/>
                    <TextBlock Text="Settings" Style="{StaticResource H2}" FontSize="17" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <RadioButton x:Name="themeTab" GroupName="tab" IsChecked="True" Style="{StaticResource TabButton}" Checked="Tab_Checked" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Theme"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="colorsTab" GroupName="tab" Style="{StaticResource TabButton}" Checked="Tab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Editor colours"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Theme -->
        <ScrollViewer x:Name="themePanel" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22,26,10">
                <TextBlock Text="Theme" Style="{StaticResource H1}"/>
                <TextBlock Text="Applies right away and is remembered next time." Style="{StaticResource Muted}" Margin="0,4,0,18"/>
                <ItemsControl x:Name="themeList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="theme" Margin="0,0,14,14" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Checked="Theme_Checked" Tag="{Binding Name}" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                         AutomationProperties.Name="{Binding Name}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <StackPanel>
                                            <Border x:Name="frame" Width="160" Height="96" CornerRadius="10" BorderThickness="2"
                                                    BorderBrush="{DynamicResource Theme.Border}" Background="{Binding Background}" Padding="12">
                                                <StackPanel>
                                                    <Border Height="8" Width="70" CornerRadius="4" HorizontalAlignment="Left" Background="{Binding Foreground}" Opacity="0.85"/>
                                                    <Border Height="6" Width="110" CornerRadius="3" HorizontalAlignment="Left" Margin="0,8,0,0" Background="{Binding Foreground}" Opacity="0.35"/>
                                                    <Border Height="6" Width="90" CornerRadius="3" HorizontalAlignment="Left" Margin="0,5,0,0" Background="{Binding Foreground}" Opacity="0.35"/>
                                                    <Border Height="16" Width="50" CornerRadius="4" HorizontalAlignment="Right" Margin="0,10,0,0" Background="{Binding Accent}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="2,6,0,0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Theme.Muted}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Theme.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Editor colours -->
        <Grid x:Name="colorsPanel" Grid.Column="1" Margin="26,22,26,10" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,14">
                <DockPanel>
                    <ComboBox x:Name="languageComboBox" DockPanel.Dock="Right" Width="170" SelectionChanged="Language_SelectionChanged"/>
                    <TextBlock Text="Editor colours" Style="{StaticResource H1}"/>
                </DockPanel>
                <TextBlock x:Name="txtColorsHint" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Colour list -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="colorList" Margin="8,4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <ComboBox DockPanel.Dock="Right" Width="180" ItemsSource="{Binding Choices}"
                                              SelectedItem="{Binding ColorName, Mode=TwoWay}" MaxDropDownHeight="320">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="14" Height="14" CornerRadius="3" BorderThickness="1"
                                                            BorderBrush="{DynamicResource Theme.Border}"
                                                            Background="{Binding Converter={StaticResource ColorBrush}}" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Border DockPanel.Dock="Left" Width="4" Height="18" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Live preview -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,0,1" Padding="14,8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="LIVE PREVIEW" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtPreviewFile" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <avalonedit:TextEditor x:Name="previewEditor" IsReadOnly="True" ShowLineNumbers="True"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="13.5" Padding="10,8"
                                           Background="Transparent" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,1,0,0" Padding="26,12">
            <DockPanel LastChildFill="True">
                <Button x:Name="saveColorsBtn" DockPanel.Dock="Right" Content="Save colours" Style="{StaticResource PrimaryButton}" Height="34"
                        Margin="0,0,8,0" Visibility="Collapsed" Click="SaveColors_Click"/>
                <TextBlock x:Name="txtStatus" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
