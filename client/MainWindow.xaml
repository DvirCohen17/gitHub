<Window x:Class="GitHubDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GitHubDemo.Controls"
        xmlns:core="clr-namespace:GitHubDemo.Core"
        Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="980" MinHeight="620"
        Background="{DynamicResource Theme.WindowBackground}" Foreground="{DynamicResource Theme.Foreground}"
        FontFamily="{StaticResource Font.UI}" FontSize="13.5" Icon="{StaticResource AppLogo}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        AutomationProperties.AutomationId="MainWindow">
    <Window.InputBindings>
        <KeyBinding Key="F1" Modifiers="Ctrl" Command="{Binding GoHomeCommand}"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Sidebar ===== -->
        <Border Width="76" Background="{DynamicResource Theme.SurfaceAlt}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="0,0,1,0"
                Visibility="{Binding ShowSidebar, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Width="36" Height="36" CornerRadius="9" Margin="0,16,0,14" ToolTip="gitHub Demo">
                    <Border.Background>
                        <ImageBrush ImageSource="{StaticResource AppLogo}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>

                <!-- profile & settings at the bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                    <Button Style="{StaticResource NavButton}" Command="{Binding GoSettingsCommand}" ToolTip="Settings"
                            c:Nav.IsSelected="{Binding NavKey, Converter={StaticResource Eq}, ConverterParameter=settings}"
                            AutomationProperties.Name="Settings">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="18"/>
                            <TextBlock Text="Settings" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Height="58" AutomationProperties.Name="Account" ToolTip="Your account"
                            c:Nav.IsSelected="{Binding NavKey, Converter={StaticResource Eq}, ConverterParameter=profile}"
                            Click="AccountButton_Click">
                        <c:Avatar User="{Binding Session.Me}" Size="34" ShowPresence="True"/>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Your profile" Command="{Binding GoMyProfileCommand}" Icon="&#xE77B;"/>
                                <MenuItem Header="Settings" Command="{Binding GoSettingsCommand}" Icon="&#xE713;"/>
                                <Separator/>
                                <MenuItem Header="Sign out" Command="{Binding SignOutCommand}" Icon="&#xF3B1;"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <Button Style="{StaticResource NavButton}" Command="{Binding GoHomeCommand}" ToolTip="Home: projects, friends and activity"
                            c:Nav.IsSelected="{Binding NavKey, Converter={StaticResource Eq}, ConverterParameter=home}" AutomationProperties.Name="Home">
                        <StackPanel>
                            <TextBlock Text="&#xE80F;" Style="{StaticResource Icon}" FontSize="18"/>
                            <TextBlock Text="Home" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" IsEnabled="False" ToolTip="The project you have open"
                            c:Nav.IsSelected="{Binding NavKey, Converter={StaticResource Eq}, ConverterParameter=projects}"
                            Visibility="{Binding NavKey, Converter={StaticResource Eq}, ConverterParameter=projects}">
                        <StackPanel>
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="18"/>
                            <TextBlock Text="Project" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding GoInboxCommand}" ToolTip="Inbox: invites, requests, mentions"
                            c:Nav.IsSelected="{Binding NavKey, Converter={StaticResource Eq}, ConverterParameter=inbox}" AutomationProperties.Name="Inbox">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="&#xE715;" Style="{StaticResource Icon}" FontSize="18"/>
                                <TextBlock Text="Inbox" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <Border Style="{StaticResource CountBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-12,0"
                                    Visibility="{Binding Session.Unread, Converter={StaticResource HasValue}}">
                                <TextBlock Text="{Binding Session.Unread, Converter={StaticResource Badge}}" Foreground="White" FontSize="10.5"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="UnreadBadge"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding GoExploreCommand}" ToolTip="Explore public projects"
                            c:Nav.IsSelected="{Binding NavKey, Converter={StaticResource Eq}, ConverterParameter=explore}" AutomationProperties.Name="Explore">
                        <StackPanel>
                            <TextBlock Text="&#xE909;" Style="{StaticResource Icon}" FontSize="18"/>
                            <TextBlock Text="Explore" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding GoAdminCommand}" ToolTip="Server administration"
                            c:Nav.IsSelected="{Binding NavKey, Converter={StaticResource Eq}, ConverterParameter=admin}" AutomationProperties.Name="Admin"
                            Visibility="{Binding Session.IsAdmin, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="&#xE83D;" Style="{StaticResource Icon}" FontSize="18"/>
                            <TextBlock Text="Admin" FontSize="10.5" Margin="0,3,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Page ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource Theme.Warning}" Padding="16,7"
                    Visibility="{Binding Session.IsOnline, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE871;" Style="{StaticResource Icon}" Foreground="Black" FontSize="14" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Session.ConnectionMessage}" Foreground="Black" FontWeight="SemiBold"
                               AutomationProperties.AutomationId="ConnectionBanner"/>
                    <TextBlock Text="  Your changes are paused until the connection is back." Foreground="Black" Opacity="0.75"/>
                </StackPanel>
            </Border>
            <c:PageHost Grid.Row="1" Content="{Binding CurrentPage}" IsEnabled="{Binding Session.IsOnline}"/>
        </Grid>

        <!-- ===== Notifications ===== -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Notifier.Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,22,22" Width="360" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type core:ToastItem}">
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14,12" Effect="{StaticResource Shadow}"
                            Background="{DynamicResource Theme.Surface}" AutomationProperties.AutomationId="Toast"
                            AutomationProperties.Name="{Binding Title}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Content="&#xE711;" FontSize="10"
                                    Command="{Binding CloseCommand}" VerticalAlignment="Top" Margin="6,-4,-6,0" ToolTip="Dismiss"/>
                            <Grid DockPanel.Dock="Left" Margin="0,0,12,0" VerticalAlignment="Top">
                                <c:Avatar User="{Binding User}" Size="32" Visibility="{Binding User, Converter={StaticResource HasValue}}"/>
                                <Border Width="30" Height="30" CornerRadius="15" Visibility="{Binding User, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Theme.AccentSoft}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="error">
                                                    <Setter Property="Background" Value="{DynamicResource Theme.DangerSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="14">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                <Setter Property="Text" Value="&#xE946;"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Theme.AccentText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="success">
                                                        <Setter Property="Text" Value="&#xE73E;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Success}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Kind}" Value="error">
                                                        <Setter Property="Text" Value="&#xE783;"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.Danger}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Visibility="{Binding Message, Converter={StaticResource HasValue}}"/>
                                <Button Content="Open" Style="{StaticResource LinkButton}" Command="{Binding ActivateCommand}" Margin="0,6,0,0"
                                        HorizontalAlignment="Left" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Dialog (shown on top of the page, inside this window) ===== -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource Theme.Overlay}"
              Visibility="{Binding ActiveDialog, Converter={StaticResource HasValue}}">
            <Border Style="{StaticResource Card}" Width="460" Padding="24,22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{StaticResource Shadow}" DataContext="{Binding ActiveDialog}" AutomationProperties.AutomationId="Dialog">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" FontSize="19"/>
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Visibility="{Binding Message, Converter={StaticResource HasValue}}"/>
                    <StackPanel Visibility="{Binding HasInput, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding InputLabel}" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" c:FocusOnShow.Enabled="True"
                                 AutomationProperties.AutomationId="DialogInput">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding OkCommand}"/>
                                <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}" Visibility="{Binding Error, Converter={StaticResource HasValue}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" Margin="0,0,8,0" IsCancel="True"
                                Visibility="{Binding CancelText, Converter={StaticResource HasValue}}" AutomationProperties.AutomationId="DialogCancel"/>
                        <Button Content="{Binding OkText}" Command="{Binding OkCommand}" IsDefault="True" AutomationProperties.AutomationId="DialogOk">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Theme.Danger}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Theme.Danger}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
