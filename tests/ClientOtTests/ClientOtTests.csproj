<Project Sdk="Microsoft.NET.Sdk">
  <!-- Randomized checks of the client's TextOperation (compose, transform, cursor positions). Run: dotnet run -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\client\Core\TextOperation.cs" Link="TextOperation.cs" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>
</Project>
