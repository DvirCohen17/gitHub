<Window x:Class="InstallerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="gitHub Demo Setup" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/logo.jpg"
        Background="#16181D" Foreground="#E6E8EB" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#1D2026"/>
        <SolidColorBrush x:Key="Border" Color="#30353D"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA1AB"/>
        <SolidColorBrush x:Key="Accent" Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentHover" Color="#2F6FD8"/>
        <SolidColorBrush x:Key="Danger" Color="#E5484D"/>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1D2026"/>
            <Setter Property="Foreground" Value="#E6E8EB"/>
            <Setter Property="CaretBrush" Value="#E6E8EB"/>
            <Setter Property="BorderBrush" Value="#3A3F47"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseButton" TargetType="Button">
            <Setter Property="Background" Value="#22252B"/>
            <Setter Property="Foreground" Value="#E6E8EB"/>
            <Setter Property="BorderBrush" Value="#3A3F47"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border CornerRadius="3" Background="#2A2E35"/>
                            <Border x:Name="PART_Track" CornerRadius="3"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left" Background="#3B82F6">
                                <Grid x:Name="Animation" ClipToBounds="True">
                                    <Border x:Name="PART_GlowRect" Width="120" HorizontalAlignment="Left" Background="#3B82F6" CornerRadius="3"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel>
        <!-- Branded header -->
        <Border Padding="28,24" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B2A44" Offset="0"/>
                    <GradientStop Color="#16181D" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Border Width="56" Height="56" CornerRadius="12">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/logo.jpg" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="gitHub Demo" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Real-time collaborative code editor - Setup" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Margin="28,22,28,24">
            <TextBlock Text="Downloads the latest client from your server and installs it to C:\githubDemo."
                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid x:Name="serverPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Server address" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                        <TextBox x:Name="hostTextBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Port" Foreground="{StaticResource Muted}" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                        <TextBox x:Name="portTextBox" MaxLength="5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ProgressBar x:Name="progressBar" Margin="0,22,0,0" Minimum="0" Maximum="100" Visibility="Hidden"/>
            <TextBlock x:Name="statusTextBlock" Text="Ready to install." TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource Muted}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="cancelButton" Content="Cancel" Style="{StaticResource BaseButton}" Margin="0,0,10,0"
                        Visibility="Collapsed" Click="CancelButton_Click"/>
                <Button x:Name="installButton" Content="Install" Style="{StaticResource PrimaryButton}" MinWidth="120" IsDefault="True"
                        Click="InstallButton_Click"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
